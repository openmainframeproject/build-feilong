#!/bin/bash

set -e

# On upgrade, this script runs after the files of the new version have been
# unpacked: only clean up when the package is really removed or purged.
case "$1" in
    remove|purge)
        rm -f /etc/logrotate.d/zthinlogs
        rm -f /etc/ld.so.conf.d/zthin.conf
        rm -f /usr/bin/smcli
        ;;
esac
